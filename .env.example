# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION
# Local settings matching docker-compose.yml
SQL_HOST="127.0.0.1"
SQL_DB_NAME="ds_engineering"
SQL_USER="ds_admin"
SQL_PASSWORD="ds_password123"
SQL_ADMIN_USER="ds_admin"
SQL_ADMIN_PASSWORD="ds_password123"

# VITE_YANDEX_METRICA_ID: ID счетчика Яндекс.Метрики («ДС-Инжиниринг» counter: 112028524)
VITE_YANDEX_METRICA_ID="112028524"

# TELEGRAM NOTIFICATIONS CONFIGURATION
# API-токен Telegram-бота «ДС-Инжиниринг» (выданный @BotFather)
TELEGRAM_BOT_TOKEN=""
# ID чата, супергруппы или канала для получения мгновенных уведомлений о заявках (например: -1001234567890 или 123456789)
TELEGRAM_CHAT_ID=""

# РОССИЙСКИЙ МЕССЕНДЖЕР МАКС (МАКС-БОТ И КОРПОРАТИВНЫЙ ШЛЮЗ)
# API-токен официального бота в Российском мессенджере МАКС
MAX_BOT_TOKEN=""
# ID чата, группы или канала в Российском мессенджере МАКС
MAX_CHAT_ID=""
# Корпоративный Webhook URL шлюза мессенджера МАКС (опционально)
MAX_WEBHOOK_URL=""
# Базовый адрес Bot API Российского мессенджера МАКС
MAX_API_URL="https://api.max-messenger.ru/v1"

# Dadata API Configuration
DADATA_API_KEY=""

