# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION
# Local settings matching docker-compose.yml
SQL_HOST="127.0.0.1"
SQL_DB_NAME="ds_engineering"
SQL_USER="ds_admin"
SQL_PASSWORD="ds_password123"
SQL_ADMIN_USER="ds_admin"
SQL_ADMIN_PASSWORD="ds_password123"

# VITE_YANDEX_METRICA_ID: ID счетчика Яндекс.Метрики («ДС-Инжиниринг» counter: 112028524)
VITE_YANDEX_METRICA_ID="112028524"

# TELEGRAM NOTIFICATIONS CONFIGURATION
# API-токен Telegram-бота «ДС-Инжиниринг» (выданный @BotFather)
TELEGRAM_BOT_TOKEN=""
# ID чата, супергруппы или канала для получения мгновенных уведомлений о заявках (например: -1001234567890 или 123456789)
TELEGRAM_CHAT_ID=""

# РОССИЙСКИЙ МЕССЕНДЖЕР МАКС (МАКС-БОТ И КОРПОРАТИВНЫЙ ШЛЮЗ)
# API-токен официального бота в Российском мессенджере МАКС
MAX_BOT_TOKEN=""
# ID чата, группы или канала в Российском мессенджере МАКС
MAX_CHAT_ID=""
# Корпоративный Webhook URL шлюза мессенджера МАКС (опционально)
MAX_WEBHOOK_URL=""
# Базовый адрес Bot API Российского мессенджера МАКС
MAX_API_URL="https://api.max-messenger.ru/v1"

# Dadata API Configuration (https://dadata.ru/api/)
DADATA_API_KEY=""
DADATA_SECRET_KEY=""

# === SECURITY / ADMIN API GUARD (пакет безопасности v2.9.291) ===
# Токен доступа к опасным эндпоинтам: настройки почты и DaData, пользователи (PATCH/DELETE/sync),
# очистка журнала, запись в CMS-стор. Передаётся заголовком x-admin-token (или Authorization: Bearer).
# В production без него эти эндпоинты отвечают 503 — задать обязательно.
ADMIN_API_TOKEN=""
# Число доверенных прокси спереди: 1 — если сервер за nginx, тогда X-Forwarded-For используется
# для лимитера. 0 (по умолчанию) — заголовок игнорируется, берётся адрес соединения.
TRUST_PROXY_DEPTH="0"
# Разрешить менять SMTP-хост/порт/учётные данные через POST /api/email/settings.
# По умолчанию выключено: наружу уходят только имя отправителя, reply-to и триггеры.
SMTP_ALLOW_CUSTOM_SETTINGS="false"
# Разрешить POST /api/users/sync со сбросом таблицы пользователей (resetToDefaults).
# Нужен только при первичной инициализации, потом флаг снимается.
ALLOW_USER_SYNC_RESET="false"

# КЛЮЧИ DADATA — только здесь (в коде и в data/crm_settings.json их больше нет).
# Для токена с неподтверждённым e-mail отключите SUGGESTIONS или внесите его в DADATA_DISABLED_KEYS.
DADATA_DISABLED_KEYS=""

# ПАРОЛИ ПРИЛОЖЕНИЯ ЯНДЕКС 360 — карта по managerId либо переменные на сотрудника:
# DS_SMTP_APP_PASSWORDS='{"adm-01":"…","adm-02":"…"}'
# DS_SMTP_APP_PASSWORD_ADM_01="…"
DS_SMTP_APP_PASSWORDS=""
# Глобальный SMTP-пароль (используется, когда учётная запись менеджера не выбрана)
SMTP_PASS=""
